# Hermes Router — secrets. Copy to .env and fill in real values.
# NEVER commit .env. NEVER log these values.

# Key Hermes must send as Bearer token to the router (Authorization: Bearer <ROUTER_API_KEY>)
ROUTER_API_KEY=

# Nous Portal API key (sk-nous-...)
NOUS_PORTAL_API_KEY=

# OpenRouter API key (sk-or-v1-...)
OPENROUTER_API_KEY=

# OpenCode Zen now requires a REAL API key (free tier; formerly keyless).
OPENCODE_FREE_API_KEY=
